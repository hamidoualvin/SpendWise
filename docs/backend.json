{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the SpendWise application.",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile photo (optional).",
          "format": "uri"
        },
        "defaultCurrency": {
          "type": "string",
          "description": "The user's default currency (e.g., 'USD', 'EUR')."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "displayName",
        "email",
        "createdAt"
      ]
    },
    "Account": {
      "title": "Account",
      "type": "object",
      "description": "Represents a user's account (e.g., 'Cash', 'Bank').",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "name": {
          "type": "string",
          "description": "The name of the account."
        },
        "currency": {
          "type": "string",
          "description": "The currency of the account."
        },
        "initialBalanceCents": {
          "type": "number",
          "description": "The initial balance of the account in cents."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "currency",
        "initialBalanceCents",
        "createdAt"
      ]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "description": "Represents a spending category (e.g., 'Food', 'Transportation').",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "name": {
          "type": "string",
          "description": "The name of the category."
        },
        "type": {
          "type": "string",
          "description": "The type of the category ('expense' or 'income')."
        },
        "icon": {
          "type": "string",
          "description": "Icon associated with the category (optional)."
        },
        "color": {
          "type": "string",
          "description": "Color associated with the category (optional)."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the category was created.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "type",
        "createdAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "accountId": {
          "type": "string",
          "description": "Reference to Account."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to Category."
        },
        "type": {
          "type": "string",
          "description": "The type of transaction ('expense' or 'income')."
        },
        "amountCents": {
          "type": "number",
          "description": "The transaction amount in cents."
        },
        "currency": {
          "type": "string",
          "description": "The currency of the transaction."
        },
        "date": {
          "type": "string",
          "description": "The effective date of the transaction.",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "description": "Optional note for the transaction."
        },
        "tags": {
          "type": "array",
          "description": "Optional array of tags associated with the transaction.",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "description": "The source of the transaction ('manual', 'import', 'recurring') (optional)."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the transaction was created.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "accountId",
        "categoryId",
        "type",
        "amountCents",
        "currency",
        "date",
        "createdAt"
      ]
    },
    "Budget": {
      "title": "Budget",
      "type": "object",
      "description": "Represents a monthly budget goal for a specific category.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "month": {
          "type": "string",
          "description": "The month for the budget (YYYY-MM)."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to Category."
        },
        "limitCents": {
          "type": "number",
          "description": "The budget limit in cents."
        },
        "currency": {
          "type": "string",
          "description": "The currency of the budget."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the budget was created.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "month",
        "categoryId",
        "limitCents",
        "currency",
        "createdAt"
      ]
    },
    "RecurringRule": {
      "title": "RecurringRule",
      "type": "object",
      "description": "Represents a rule for recurring transactions.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "type": {
          "type": "string",
          "description": "The type of transaction ('expense' or 'income')."
        },
        "accountId": {
          "type": "string",
          "description": "Reference to Account."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to Category."
        },
        "amountCents": {
          "type": "number",
          "description": "The transaction amount in cents."
        },
        "currency": {
          "type": "string",
          "description": "The currency of the transaction."
        },
        "frequency": {
          "type": "string",
          "description": "The frequency of the recurring rule ('weekly', 'monthly', 'yearly')."
        },
        "dayOfMonth": {
          "type": "number",
          "description": "The day of the month for monthly recurring rules (optional)."
        },
        "dayOfWeek": {
          "type": "number",
          "description": "The day of the week for weekly recurring rules (optional)."
        },
        "nextRunAt": {
          "type": "string",
          "description": "Timestamp indicating the next run time for the rule.",
          "format": "date-time"
        },
        "active": {
          "type": "boolean",
          "description": "Indicates whether the recurring rule is active."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the recurring rule was created.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "type",
        "accountId",
        "categoryId",
        "amountCents",
        "currency",
        "frequency",
        "nextRunAt",
        "active",
        "createdAt"
      ]
    },
    "InsightsCache": {
      "title": "InsightsCache",
      "type": "object",
      "description": "Represents a cache of generated spending insights.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "period": {
          "type": "string",
          "description": "The period for which the insights were generated (e.g., 'YYYY-MM', 'last_30_days')."
        },
        "summary": {
          "type": "string",
          "description": "A summary of the spending insights."
        },
        "bullets": {
          "type": "array",
          "description": "An array of bullet points highlighting key insights.",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "string",
          "description": "A map of key metrics related to the insights (e.g., 'topCategory', 'spendTotalCents')."
        },
        "generatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the insights were generated.",
          "format": "date-time"
        },
        "ttlExpiresAt": {
          "type": "string",
          "description": "Timestamp indicating when the cache entry should expire.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "period",
        "summary",
        "bullets",
        "metrics",
        "generatedAt",
        "ttlExpiresAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/User"
      },
      "description": "Stores user profile information. Only the authenticated user can read or write their own document."
    },
    "/accounts/{accountId}": {
      "schema": {
        "$ref": "#/backend/entities/Account"
      },
      "description": "Stores user account information. Includes denormalized 'userId' for authorization independence."
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/backend/entities/Category"
      },
      "description": "Stores user-defined categories. Includes denormalized 'userId' for authorization independence."
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/backend/entities/Transaction"
      },
      "description": "Stores transaction data. Includes denormalized 'userId' for authorization independence."
    },
    "/budgets/{budgetId}": {
      "schema": {
        "$ref": "#/backend/entities/Budget"
      },
      "description": "Stores budget information. Includes denormalized 'userId' for authorization independence."
    },
    "/recurringRules/{ruleId}": {
      "schema": {
        "$ref": "#/backend/entities/RecurringRule"
      },
      "description": "Stores recurring rule definitions. Includes denormalized 'userId' for authorization independence."
    },
    "/insightsCache/{cacheId}": {
      "schema": {
        "$ref": "#/backend/entities/InsightsCache"
      },
      "description": "Stores cached insights. Includes denormalized 'userId' for authorization independence."
    }
  }
}

    