rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Incoming document
    function isCreatingOwnedDoc() {
      return isOwner(request.resource.data.userId);
    }
    
    // Existing document
    function isAccessingOwnedDoc() {
      // Check for the existence of userId before accessing it.
      return isSignedIn() && 'userId' in resource.data && isOwner(resource.data.userId);
    }
    
    // Ensure owner is not changed on update
    function isUpdatingOwnedDoc() {
      return isAccessingOwnedDoc() && request.resource.data.userId == resource.data.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get, update, create: if isOwner(userId);
      allow delete, list: if false;
    }

    match /{collection}/{docId} 
    where collection in ['accounts', 'categories', 'transactions', 'budgets', 'recurringRules', 'insightsCache'] {
      // Allow reading single documents or listing documents if the query is properly filtered.
      allow get: if isAccessingOwnedDoc();
      allow list: if isSignedIn(); // Queries are further secured by 'get' rules and indexes.

      // Documents can be created by a signed-in user, as long as they set themselves as the owner.
      allow create: if isSignedIn() && isCreatingOwnedDoc();

      // Documents can be updated only by their owner, and the owner cannot be changed.
      allow update: if isSignedIn() && isUpdatingOwnedDoc();

      // Individual documents can be deleted only by their owner.
      allow delete: if isSignedIn() && isAccessingOwnedDoc();
    }
  }
}
