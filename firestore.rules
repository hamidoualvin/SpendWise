rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{userId} {
      // Users can read, create, update, and delete their own profile.
      allow read, write: if request.auth.uid == userId;
      // Listing all users is not allowed.
      allow list: if false;
    }

    // User subcollections (accounts, transactions, etc.)
    match /users/{userId}/{subcollection}/{docId} {
      // A user can read and write any document within their own subcollections.
      // This rule works because the {userId} wildcard in the path is checked
      // against the authenticated user's ID.
      allow read, write: if request.auth.uid == userId;
    }
  }
}
