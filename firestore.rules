rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Incoming document
    function isCreatingOwnedDoc() {
      return isOwner(request.resource.data.userId);
    }
    
    // Existing document
    function isAccessingOwnedDoc() {
      return isOwner(resource.data.userId);
    }
    
    // Ensure owner is not changed on update
    function isUpdatingOwnedDoc() {
      return isAccessingOwnedDoc() && request.resource.data.userId == resource.data.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // A user can read, create, and update their own document.
      allow get, update, create: if isOwner(userId);
      
      // Do not allow users to be deleted for now, and no one can list all users.
      allow delete, list: if false;
    }

    // Generic rule for collections with a `userId` field
    match /{collection}/{docId} 
    where collection in ['accounts', 'categories', 'transactions', 'budgets', 'recurringRules', 'insightsCache'] {
      // Individual documents can be read (get) or deleted only by their owner.
      allow get, delete: if isSignedIn() && isAccessingOwnedDoc();
      
      // Collection queries (list) are allowed if the user is signed in.
      // The query itself MUST be constrained in the app code (e.g., where('userId', '==', auth.uid))
      // to ensure it only requests documents the user is allowed to 'get'.
      allow list: if isSignedIn();

      // Documents can be created by a signed-in user, as long as they set themselves as the owner.
      allow create: if isSignedIn() && isCreatingOwnedDoc();

      // Documents can be updated only by their owner, and the owner cannot be changed.
      allow update: if isSignedIn() && isUpdatingOwnedDoc();
    }
  }
}
