rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Incoming document
    function isCreatingOwnedDoc() {
      return isOwner(request.resource.data.userId);
    }
    
    // Existing document
    function isAccessingOwnedDoc() {
      return isOwner(resource.data.userId);
    }
    
    // Ensure owner is not changed on update
    function isUpdatingOwnedDoc() {
      return isAccessingOwnedDoc() && request.resource.data.userId == resource.data.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get, update, write: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn();
      // Do not allow users to be deleted for now
      allow delete: if false; 
      allow list: if false; // Prevent listing all users.
    }

    // Generic rule for collections with a `userId` field
    match /{collection}/{docId} 
    where collection in ['accounts', 'categories', 'transactions', 'budgets', 'recurringRules', 'insightsCache'] {
      allow read, delete: if isSignedIn() && isAccessingOwnedDoc();
      allow create: if isSignedIn() && isCreatingOwnedDoc();
      allow update: if isSignedIn() && isUpdatingOwnedDoc();
      allow list: if isSignedIn(); // Covered by query constraints in the app
    }
  }
}

    