rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A user can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Generic rules for all user-owned collections
    match /{collection}/{docId}
      where collection in ['accounts', 'categories', 'transactions', 'budgets', 'recurringRules', 'insightsCache'] {

        // READ:
        // A user can read a document if they are the owner.
        // For list operations, the query MUST include a `where('userId', '==', request.auth.uid)` clause.
        allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

        // CREATE:
        // A user can create a document if they are signing it with their own userId.
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;

        // UPDATE:
        // A user can update their own document, but they cannot change the userId.
        allow update: if isSignedIn() && request.auth.uid == resource.data.userId
                      && request.resource.data.userId == resource.data.userId;

        // DELETE:
        // A user can delete their own document.
        allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
